# Squad
SQUAD_SECRET_KEY=sandbox_sk_...
SQUAD_PUBLIC_KEY=sandbox_pk_...
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_WEBHOOK_SECRET=<webhook_secret>
# Payout API: transaction_reference must be prefixed with this (Squad dashboard merchant ID)
SQUAD_MERCHANT_ID=YOUR_MERCHANT_ID
SQUAD_BENEFICIARY_ACCOUNT= 8086321931
SQUAD_BENEFICIARY_BANK_CODE= 0000

# Database
DATABASE_URL=postgresql://user:pass@neon.tech/paydrop

# Redis
REDIS_URL=redis://your-upstash-url

# JWT
JWT_ACCESS_SECRET=<random_64_char_string>
JWT_REFRESH_SECRET=<random_64_char_string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Firebase
FIREBASE_PROJECT_ID=paydrop
FIREBASE_CLIENT_EMAIL=...
FIREBASE_PRIVATE_KEY=...

# Squad Test Configuration
SQUAD_TEST_BVN=22110011001
# Squad expects DOB as mm/dd/yyyy
SQUAD_TEST_DOB=10/30/1990

# Termii
TERMII_API_KEY=...
# REQUIRED: must be an approved Sender ID in your Termii dashboard (example: talert)
TERMII_SENDER_ID=

# Fraud Service
FRAUD_SERVICE_URL=http://localhost:8000

# App
PORT=3000
NODE_ENV=development

# Auth test mode (no SMS, preset logins). Never enable in production.
AUTH_TEST_MODE=true
TEST_AUTH_OTP=123456